    "scope": "wc_only",
    "title": "WC replacement",
    "description": "Replace one WC like for like (close-coupled) or with a wall-hung pan on a concealed frame. Separate WC replacement is its own line in council kitchen and bathroom programmes.",
    "version": "0.2.0"
  },
  "max_upfront_questions": 3,
  "upfront_questions": [
    "wc_type",
    "soil_outlet",
    "joint_system"
