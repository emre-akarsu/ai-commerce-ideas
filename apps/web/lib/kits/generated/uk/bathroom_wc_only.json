      "label": "Wall area to paint",
      "default": "3",
      "default_label": "3 m2",
      "unit": "m2"
    },
    {
      "kind": "allowance",
      "key": "paint_ceiling_m2",
      "label": "Ceiling area to paint",
      "default": "0",
      "default_label": "0 m2",
      "unit": "m2"
    }
  ],
  "measurements": [],
  "derived": [
    {
      "id": "sealant_m_per_cartridge",
      "formula": "sealant_cartridge_ml / (sealant_joint_width_mm * sealant_joint_depth_mm)",
      "unit": "m",
      "description": "Sealant bead length per cartridge."
    },
    {
      "id": "paint_litres",
      "formula": "(paint_wall_m2 + paint_ceiling_m2) * (emulsion_finish_coats + emulsion_mist_coats) / emulsion_coverage_m2_per_l",
      "unit": "l",
      "description": "Emulsion for walls and ceiling, all coats."
    }
  ],
