  "rules": [
    {
      "id": "joint_system_compression",
      "when": "joint_system == 'compression'",
      "requires": [
        "ff_fittings_compression"
      ],
      "excludes": [
        "ff_fittings_push_fit",
        "ff_fittings_solder",
        "ff_flux"
      ],
      "rationale": "Merchants split fittings by joint technology, so the kit carries one family only."
    },
    {
      "id": "joint_system_push_fit",
      "when": "joint_system == 'push_fit'",
      "requires": [
        "ff_fittings_push_fit"
      ],
      "excludes": [
        "ff_fittings_compression",
        "ff_fittings_solder",
        "ff_flux"
      ],
      "rationale": "Merchants split fittings by joint technology, so the kit carries one family only."
    },
    {
      "id": "joint_system_solder",
      "when": "joint_system == 'solder'",
      "requires": [
        "ff_fittings_solder",
        "ff_flux"
      ],
      "excludes": [
        "ff_fittings_compression",
        "ff_fittings_push_fit"
      ],
      "rationale": "Merchants split fittings by joint technology, so the kit carries one family only."
    },
    {
      "id": "wall_hung_wc",
      "when": "wc_type == 'wall_hung'",
      "requires": [
        "sw_wc_frame",
        "sw_wc_flush_plate",
        "sw_wc_pan_wall_hung",
        "sw_wc_seat"
      ],
      "excludes": [
        "sw_wc_pan_connector",
        "sw_wc_pan_close_coupled",
        "sw_wc_cistern"
      ],
      "rationale": "A wall-hung WC needs a concealed frame, a flush plate and a wall-hung pan. The frames cited ship a 90 mm bend with a 90/110 mm adaptor, so a separate 110 mm pan connector is not added (this differs from the original brief). Plate must match the cistern maker and series; that compatibility is a SKU check, not encoded here."
    },
    {
      "id": "close_coupled_wc",
      "when": "wc_type == 'close_coupled'",
      "requires": [
        "sw_wc_pan_close_coupled",
        "sw_wc_cistern",
        "sw_wc_seat",
        "sw_wc_flush_lever",
        "ff_iv_wc"
      ],
      "excludes": [
        "sw_wc_frame",
        "sw_wc_flush_plate",
        "sw_wc_pan_wall_hung"
      ],
      "rationale": "A close-coupled suite is bought as pan, cistern, seat and lever, plus a pan connector chosen by the soil outlet and an isolating valve on the cistern feed."
    },
    {
      "id": "stud_wall_fixings",
      "when": "wall_type == 'stud'",
      "requires": [
        "cs_fixings_stud"
      ],
      "excludes": [
        "cs_fixings_solid"
      ],
      "rationale": "Mira guides warn stud partitions may need alternative fixings; wall fixings are not supplied."
    },
    {
      "id": "solid_wall_fixings",
      "when": "wall_type == 'solid'",
      "requires": [
        "cs_fixings_solid"
      ],
      "excludes": [
        "cs_fixings_stud"
      ],
      "rationale": "Wall fixings suited to the substrate are not supplied."
    },
    {
      "id": "pan_connector_horizontal",
      "when": "wc_type == 'close_coupled' and soil_outlet == 'horizontal'",
      "requires": [
        "sw_wc_pan_connector"
      ],
      "excludes": [
        "sw_wc_pan_connector_vertical"
      ],
      "rationale": "The connector depends on the soil position: horizontal outlet to P trap."
    },
    {
      "id": "pan_connector_vertical",
      "when": "wc_type == 'close_coupled' and soil_outlet == 'vertical'",
      "requires": [
        "sw_wc_pan_connector_vertical"
      ],
      "excludes": [
        "sw_wc_pan_connector"
      ],
      "rationale": "The connector depends on the soil position: S or turned P trap."
    },
    {
      "id": "wall_hung_no_pan_connector",
      "when": "wc_type == 'wall_hung'",
      "requires": [],
      "excludes": [
        "sw_wc_pan_connector",
        "sw_wc_pan_connector_vertical"
      ],
      "rationale": "Wall-hung frames connect through their own 90/110 mm adaptor whatever the soil position."
    },
    {
      "id": "close_coupled_consumables",
      "when": "wc_type == 'close_coupled'",
      "requires": [
        "cs_wc_packers",
        "cs_clear_sealant_wc",
        "cs_thread_sealant"
      ],
      "excludes": [],
      "rationale": "Pan installation needs packers, silicone and PTFE."
    }
  ]
}
