  "questions": [
    {
      "id": "wc_type",
      "question": "WC type?",
      "type": "enum",
      "ask": "upfront",
      "priority": 11,
      "default": "close_coupled",
      "options": [
        {
          "value": "close_coupled",
          "label": "Close-coupled (cistern on the pan)"
        },
        {
          "value": "wall_hung",
          "label": "Wall-hung pan on a concealed frame"
        }
      ]
    },
    {
      "id": "soil_outlet",
      "question": "Where does the soil pipe leave the pan position?",
      "type": "enum",
      "ask": "upfront",
      "priority": 2,
      "default": "horizontal",
      "options": [
        {
          "value": "horizontal",
          "label": "Through the wall (horizontal)"
        },
        {
          "value": "vertical",
          "label": "Through the floor (vertical)"
        }
      ]
    },
    {
      "id": "wall_type",
      "question": "Main wall construction where fittings are fixed?",
      "type": "enum",
      "ask": "on_review",
      "priority": 2,
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid (brick or block)"
        },
        {
          "value": "stud",
          "label": "Stud (timber or metal frame)"
        }
      ]
    },
    {
      "id": "joint_system",
      "question": "Pipe joint system for new pipework?",
      "type": "enum",
      "ask": "upfront",
      "priority": 4,
      "default": "compression",
      "options": [
        {
          "value": "compression",
          "label": "Compression"
        },
        {
          "value": "push_fit",
          "label": "Push-fit"
        },
        {
          "value": "solder",
          "label": "Solder-ring"
        }
      ]
    }
  ],
